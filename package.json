{
  "name": "api-chain",
  "version": "1.0.0",
  "description": "A small Node.js service that chains public APIs: calls one, validates the response, and feeds data into the next — a mini service orchestrator, built with its own automated test suite.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CesarNr/api-chain.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "api-testing",
    "automation",
    "qa",
    "rest-api",
    "portfolio"
  ],
  "author": "CesarNr",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CesarNr/api-chain/issues"
  },
  "homepage": "https://github.com/CesarNr/api-chain#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node"
  }
}
